# NAWA Technology - environment
# Copy to .env.local and point these at your own backend.

# Base URL of your API. When unset, the frontend renders EMPTY states
# (nothing is faked) and the local API stubs under src/app/api are used.
NEXT_PUBLIC_API_URL=

# Server-side only.
DATABASE_URL=
API_SECRET=

# Set to false in production to hide the developer state-switcher.
NEXT_PUBLIC_ENABLE_STATE_PREVIEW=true
